# ─────────────────────────────────────────────────────────────
# Baitler environment configuration — copy to `.env` and fill in.
# Never commit `.env`. See README.md for details.
# ─────────────────────────────────────────────────────────────

# ── Backend: HTTP server ──
PORT=8080
# Bind host. NOTE: named BIND_HOST (not HOST) to avoid clobbering by shells /
# build tools that set HOST to a target triple. Default 0.0.0.0.
BIND_HOST=0.0.0.0
# Comma-separated origins allowed by CORS (the frontend dev server)
CORS_ALLOWED_ORIGINS=http://localhost:8100

# ── Backend: SurrealDB ──
# Connection URL for the SurrealDB `any` engine. Options:
#   rocksdb://./data/surreal.db  embedded, file-based, persists across restarts ← default
#   memory                       embedded, in-process, ephemeral (no persistence)
#   ws://127.0.0.1:8000          remote server (run `surreal start`); set USER/PASS below
#   http://127.0.0.1:8000        remote server over HTTP
# The rocksdb directory is created automatically on first run (./data is gitignored).
SURREAL_URL=rocksdb://./data/surreal.db
# Credentials are only needed for a remote server; leave blank for embedded engines.
SURREAL_USER=
SURREAL_PASS=
SURREAL_NS=baitler
SURREAL_DB=baitler
# Upper bound (seconds) on a single DB operation, e.g. the /health ping.
SURREAL_TIMEOUT_SECS=5

# ── Auth: session/JWT ──
# Generate a long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me

# ── Secrets encryption ──
# Master secret used to encrypt stored secrets at rest (e.g. LLM provider API
# keys). REQUIRED in production; a dev default is used if unset (with a warning).
# Generate, e.g. `openssl rand -hex 32`.
APP_SECRET=

# ── Auth: OAuth2 providers (Phase 2) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8080

# ── File storage (Phase 4) ──
# `local` for dev, or an S3-compatible store in prod (S3 not yet implemented)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/files
# Maximum upload size per request, in MB (DefaultBodyLimit → 413 when exceeded)
MAX_UPLOAD_MB=50
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ── LLM providers (Phase 6) ──
# API keys are managed per-user IN THE APP (AI → settings) and stored encrypted
# at rest (see APP_SECRET above) — not via env. The "Mock" provider needs no key.

# ── MCP server (Model Context Protocol) ──
# Baitler serves MCP over Streamable HTTP at POST /mcp, and ships a stdio bridge
# binary (`baitler-mcp`). See docs/mcp.md for client setup (Claude Code, Hermes, …).
# Set MCP_ENABLED=false to remove the /mcp endpoint entirely.
MCP_ENABLED=true
# When set, every /mcp request must send `Authorization: Bearer <token>`.
# Leave blank for an open endpoint (only safe behind a localhost bind / trusted net).
# Generate, e.g. `openssl rand -hex 32`.
MCP_AUTH_TOKEN=

# ── Frontend (Vite) — must be prefixed VITE_ to reach the client ──
VITE_API_BASE_URL=http://localhost:8080
