# ─────────────────────────────────────────────────────────────
# Baitler environment configuration — copy to `.env` and fill in.
# Never commit `.env`. See README.md for details.
# ─────────────────────────────────────────────────────────────

# ── Backend: HTTP server ──
PORT=8080
# Bind host. NOTE: named BIND_HOST (not HOST) to avoid clobbering by shells /
# build tools that set HOST to a target triple. Default 0.0.0.0.
BIND_HOST=0.0.0.0
# Comma-separated origins allowed by CORS (the frontend dev server)
CORS_ALLOWED_ORIGINS=http://localhost:8100

# ── Backend: SurrealDB ──
# Connection URL for the SurrealDB `any` engine. Options:
#   rocksdb://./data/surreal.db  embedded, file-based, persists across restarts ← default
#   memory                       embedded, in-process, ephemeral (no persistence)
#   ws://127.0.0.1:8000          remote server (run `surreal start`); set USER/PASS below
#   http://127.0.0.1:8000        remote server over HTTP
# The rocksdb directory is created automatically on first run (./data is gitignored).
SURREAL_URL=rocksdb://./data/surreal.db
# Credentials are only needed for a remote server; leave blank for embedded engines.
SURREAL_USER=
SURREAL_PASS=
SURREAL_NS=baitler
SURREAL_DB=baitler
# Upper bound (seconds) on a single DB operation, e.g. the /health ping.
SURREAL_TIMEOUT_SECS=5

# ── Auth: session/JWT ──
# Generate a long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me

# ── Secrets encryption ──
# Master secret used to encrypt stored secrets at rest (e.g. LLM provider API
# keys). REQUIRED in production; a dev default is used if unset (with a warning).
# Generate, e.g. `openssl rand -hex 32`.
APP_SECRET=

# ── Auth: OAuth2 providers (Phase 2) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8080

# ── File storage (Phase 4) ──
# `local` for dev, or an S3-compatible store in prod (S3 not yet implemented)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/files
# Maximum upload size per request, in MB (DefaultBodyLimit → 413 when exceeded)
MAX_UPLOAD_MB=50
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ── LLM providers (Phase 6) ──
# API keys are managed per-user IN THE APP (AI → settings) and stored encrypted
# at rest (see APP_SECRET above) — not via env. The "Mock" provider needs no key.

# ── MCP server (Model Context Protocol) ──
# Baitler serves MCP over Streamable HTTP at POST /mcp, and ships a stdio bridge
# binary (`baitler-mcp`). See docs/mcp.md for client setup (Claude Code, Hermes, …).
# Set MCP_ENABLED=false to remove the /mcp endpoint entirely.
MCP_ENABLED=true
# When set, every /mcp request must send `Authorization: Bearer <token>`.
# Leave blank for an open endpoint (only safe behind a localhost bind / trusted net).
# Generate, e.g. `openssl rand -hex 32`.
MCP_AUTH_TOKEN=

# ── Plugin system (Phase 16) ──
# Agent-authored, human-approved extensions (MCP tools / API endpoints / UI),
# executed in an embedded WASM sandbox. Off by default — enabling it is a
# deliberate act; the runtime additionally requires building with
# `--features plugins` once the Phase 16.B loader lands.
PLUGINS_ENABLED=false

# ── Document conversion / export (PDF, Word) ──
# Headless Chrome renders HTML→PDF; Pandoc renders HTML→DOCX. Both are optional —
# the matching export returns 503 when the binary is absent.
CHROME_BIN=google-chrome-stable
PANDOC_BIN=pandoc
# Server-side render = SSRF surface. Defenses: HTML is stripped of remote resource
# loads before rendering, and Chrome resolves no hostnames. For full isolation
# against IP-literal SSRF, run Chrome in a network namespace / egress-blocked
# sandbox. `--no-sandbox` is on by default (needed when Chrome runs as root in
# containers/CI); on a hardened host that allows the real sandbox, set this false.
CHROME_NO_SANDBOX=true

# ── Public page hosting (Phase 12) ──
# Published pages are served at GET /p/{slug} (outside the credentialed CORS layer,
# behind a strict no-script CSP). PUBLIC_PAGE_ORIGIN is the absolute origin used to
# build shareable URLs. For real isolation it should be a DISTINCT origin from the
# app/cookie origin (e.g. https://pages.baitler.com), and once auth lands the
# session cookie must NEVER be set on an origin that serves /p/*. Leave blank in
# single-host dev — share URLs then stay origin-relative and the CSP `sandbox`
# (opaque, cookieless origin) is the active protection.
PUBLIC_PAGE_ORIGIN=

# ── Claude Code CLI runner (Phase 13) ──
# Lets a user invoke Claude Code from inside Baitler (POST /cli/runs). The runner
# spawns `claude` HEADLESS in a per-run sandbox dir and points it back at this
# server's own /mcp (so the agent works on the user's KB; its writes are draft-
# gated + attributed to `claude-code`). OFF by default — it executes a powerful
# agent. A real run needs network egress and an AUTHENTICATED `claude` CLI — either
# a `claude login` session in the server's $HOME/.claude, or an ANTHROPIC_API_KEY in
# the server env, or a per-owner key stored via Baitler's AI settings (which, when
# present, overrides the host's for that run). No Baitler-stored key is required if
# `claude` is already logged in. Setting CLAUDE_BIN=mock selects an in-process
# scripted runner (no subprocess/egress) for offline dev.
CLAUDE_CLI_ENABLED=false
CLAUDE_BIN=claude
# Root dir for ephemeral per-run sandboxes (created + removed per run).
CLAUDE_CLI_WORKDIR=
# Hard wall-clock cap per run (the child is killed past it) and a turn cap.
CLAUDE_CLI_TIMEOUT_SECS=600
CLAUDE_CLI_MAX_TURNS=24
# Default model when a run doesn't specify one (blank → let the CLI pick).
CLAUDE_CLI_DEFAULT_MODEL=
# When false (default) the spawned agent gets ONLY the Baitler MCP tools; host
# Bash/Write/Edit are disallowed and --dangerously-skip-permissions is never used.
CLAUDE_CLI_ALLOW_HOST_TOOLS=false
# ── Workspace roots (local disk access) ──
# Absolute host directories Baitler may touch on the local disk, shared by:
#  - the per-run READ-ONLY folder grant for agent runs (Read/Glob/Grep, no write),
#  - the folder-attach browse picker (GET /cli/workspace/browse),
#  - the MCP `workspace_*` file tools (full file management for external MCP
#    clients — NOT available to Baitler-spawned agent runs).
# Colon- or comma-separated ABSOLUTE dirs; every path must resolve within one of
# these (canonicalized — no `..` or symlink escape). Empty (default) disables
# all local-disk access. Legacy alias CLAUDE_CLI_WORKSPACE_ROOTS still works.
# Example: WORKSPACE_ROOTS=/home/bart/Documents,/home/bart/Projects
WORKSPACE_ROOTS=
# URL the spawned agent's loopback MCP config points at. Blank → this process's
# own http://127.0.0.1:<PORT>/mcp. Set for split-host deploys.
CLAUDE_CLI_MCP_URL=
# MiniMax agent provider (optional second backend, selectable in the Agent panel).
# It drives the SAME `claude` CLI against MiniMax's Anthropic-compatible endpoint,
# so it also needs CLAUDE_CLI_ENABLED=true + an installed `claude`. Set the
# subscription key (an `sk-cp-…` value from platform.minimax.io) to enable it.
# Base URL + model have sensible defaults per MiniMax's docs. Baitler maps ALL of
# Claude Code's model slots (main + small/fast/haiku) to MINIMAX_MODEL so its
# background calls don't hit a Claude model name the MiniMax gateway lacks (which
# would 404 and stall tool/MCP use).
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M3

# ── Frontend (Vite) — must be prefixed VITE_ to reach the client ──
VITE_API_BASE_URL=http://localhost:8080

# Origin the embedded draw.io editor (Phase 14 Diagrams) is loaded from. Defaults
# to the hosted embed (https://embed.diagrams.net). For privacy, self-host draw.io
# and point this at your own deploy — the diagram XML stays client-side over
# postMessage either way, but self-hosting removes the third-party dependency. The
# live editor frame loads ONLY on the Diagrams authoring route; everywhere else
# (and on the public /p/* page surface) diagrams render as static SVG/PNG. When
# self-hosting, also restrict the SPA's `frame-src` CSP to this origin.
VITE_DRAWIO_URL=https://embed.diagrams.net
