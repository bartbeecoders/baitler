# ─────────────────────────────────────────────────────────────
# Baitler environment configuration — copy to `.env` and fill in.
# Never commit `.env`. See README.md for details.
# ─────────────────────────────────────────────────────────────

# ── Backend: HTTP server ──
PORT=8080
# Comma-separated origins allowed by CORS (the frontend dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Backend: SurrealDB ──
SURREAL_URL=ws://127.0.0.1:8000
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=baitler
SURREAL_DB=baitler

# ── Auth: session/JWT ──
# Generate a long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me

# ── Auth: OAuth2 providers (Phase 2) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8080

# ── File storage (Phase 4) ──
# `local` for dev, or an S3-compatible store in prod
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/files
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ── LLM providers (Phase 6) — optional, set per provider you use ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
FAL_API_KEY=

# ── Frontend (Vite) — must be prefixed VITE_ to reach the client ──
VITE_API_BASE_URL=http://localhost:8080
